@model Tax
@{
    ViewData["Title"] = "Tax";
}

<h4>@(Model.TaxId == 0 ? "Add Tax" : "Edit Tax")</h4>

<form asp-action="Save" method="post" style="max-width:500px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="TaxId" />

    <div class="mb-2">
        <label asp-for="TaxName" class="form-label"></label>
        <input asp-for="TaxName" class="form-control" />
        <span asp-validation-for="TaxName" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="TaxType" class="form-label"></label>
        <select asp-for="TaxType" class="form-select" id="TaxType" onchange="showAdditional()">
            <option value="Single">Single</option>
            <option value="Compound">Compound</option>
        </select>
        <span asp-validation-for="TaxType" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="TaxRate" class="form-label"></label>
        <input asp-for="TaxRate" class="form-control" />
        <span asp-validation-for="TaxRate" class="text-danger"></span>
    </div>
    <div class="mb-2" id="additionalBox">
        <label asp-for="AdditionalRate" class="form-label"></label>
        <input asp-for="AdditionalRate" class="form-control" />
        <span asp-validation-for="AdditionalRate" class="text-danger"></span>
        <small class="text-muted">Charged on (taxable amount + first tax)</small>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <script>
        function showAdditional() {
            var type = document.getElementById("TaxType").value;
            document.getElementById("additionalBox").style.display = (type == "Compound") ? "block" : "none";
        }
        showAdditional();
    </script>
}
